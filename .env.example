# Proveedor de modelo de lenguaje (DeepSeek) — backend únicamente.
# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Opcionales
PORT=8787
TZ=America/Bogota
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=200000
LLM_TIMEOUT_MS=60000
RATE_LIMIT_PER_MINUTE=30
ACCESS_TOKEN=